#!/bin/bash
ASTRO_REPO="$HOME/Documents/theogieruc.dev"
SUBMODULE_PATH="mhl-carte"

if [ ! -d "$ASTRO_REPO/.git" ]; then
	echo "Astro repo not found at $ASTRO_REPO, skipping submodule update"
	exit 0
fi

# Get the commit hash we just made
MAP_COMMIT="$(git rev-parse HEAD)"

echo "Updating submodule pointer in theogieruc.dev to $MAP_COMMIT..."
cd "$ASTRO_REPO"

# Point submodule to the local commit (works because both repos are local)
git -C "$SUBMODULE_PATH" fetch "$OLDPWD" main
git -C "$SUBMODULE_PATH" checkout "$MAP_COMMIT"
git add "$SUBMODULE_PATH"

if git diff --cached --quiet; then
	echo "Submodule already up to date"
else
	git commit -m "chore: update mhl-carte submodule"
fi
