#!/bin/bash
ASTRO_REPO="$HOME/Documents/theogieruc.dev"
MAP_REPO="$(git rev-parse --show-toplevel)"
SUBMODULE_PATH="mhl-carte"

if [ ! -d "$ASTRO_REPO/.git" ]; then
	echo "Astro repo not found at $ASTRO_REPO, skipping submodule update"
	exit 0
fi

MAP_COMMIT="$(git rev-parse HEAD)"

echo "Updating submodule in theogieruc.dev to $(echo $MAP_COMMIT | head -c 7)..."
cd "$ASTRO_REPO"

# Fetch from the local map repo into the submodule's object store
GIT_DIR="$ASTRO_REPO/.git/modules/$SUBMODULE_PATH"
git --git-dir="$GIT_DIR" --work-tree="$ASTRO_REPO/$SUBMODULE_PATH" fetch "$MAP_REPO" main
git --git-dir="$GIT_DIR" --work-tree="$ASTRO_REPO/$SUBMODULE_PATH" checkout "$MAP_COMMIT"

git add "$SUBMODULE_PATH"

if git diff --cached --quiet; then
	echo "Submodule already up to date"
else
	git commit -m "chore: update mhl-carte submodule"
fi
